          "minItems": 0,
          "uniqueItems": true
        },
        "unknown_timestamps": {
          "type": "integer",
          "minimum": 0
        },
        "end_verified": {
          "type": "boolean"
        },
        "receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "[0-9a-f]{64}"
        },
        "error_code": {
          "enum": [
            null,
            "json_unreadable_or_invalid"
          ]
        }
      },
      "required": [
        "session_id",
        "attempt_status",
        "approval",
