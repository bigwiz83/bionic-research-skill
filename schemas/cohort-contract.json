{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bionic-research-skill:cohort:0.2.0",
  "title": "Approved derived outputs and cohort comparison plan",
  "$defs": {
    "span": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "ref",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "[A-Za-z0-9_./:-]{1,128}"
        },
        "model_id_confirmed": {
          "type": "boolean"
        },
        "settings_confirmed": {
          "type": "boolean"
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "top_p": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "context_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "model_id",
        "model_id_confirmed",
        "settings_confirmed",
        "temperature",
        "top_p",
        "context_length"
      ],
      "additionalProperties": false
    },
    "model_snapshot": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "MS-[A-Z0-9-]{1,48}"
        },
        "scope": {
          "enum": [
            "task_session_header",
            "task_response",
            "extraction_runtime",
            "task_user_report"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "S-[A-Z0-9-]{1,48}"
        },
        "response_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "META-[A-Z0-9-]{1,64}"
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "[A-Za-z0-9_./:-]{1,128}"
        },
        "reasoning_level": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "[^\\r\\n]{1,64}"
        },
        "parameters": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "top_p": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "top_k": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max_output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "context_length": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "temperature",
            "top_p",
            "top_k",
            "max_output_tokens",
            "context_length",
            "seed"
          ],
          "additionalProperties": false
        },
        "token_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "enum": [
                  "input_tokens",
                  "output_tokens",
                  "total_tokens",
                  "context_used_tokens",
                  "displayed_unknown"
                ]
              },
              "aggregation": {
                "enum": [
                  "response",
                  "session",
                  "unknown"
                ]
              },
              "value": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "metric",
              "aggregation",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": [
        "snapshot_id",
        "scope",
        "session_id",
        "response_ref",
        "evidence_ref",
        "captured_at",
        "source_timestamp",
        "model_id",
        "reasoning_level",
        "parameters",
        "token_counts"
      ],
      "additionalProperties": false
    },
    "model_context": {
      "type": "object",
      "properties": {
        "context_version": {
          "const": "1.0.0"
        },
        "collection_status": {
          "enum": [
            "observed",
            "not_available",
            "not_collected"
          ]
        },
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_snapshot"
          },
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": [
        "context_version",
        "collection_status",
        "snapshots"
      ],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "S-[A-Z0-9-]{1,48}"
        },
        "purpose": {
          "enum": [
            "task",
            "analysis"
          ]
        },
        "approved": {
          "type": "boolean"
        },
        "attempt_status": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "interrupted",
            "resumed",
            "unknown"
          ]
        },
        "access": {
          "enum": [
            "available",
            "missing_access",
            "unreadable",
            "missing_record"
          ]
        },
        "events_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "total_events": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "end_verified": {
          "type": "boolean"
        },
        "analysis_start_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "read_receipts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": [
        "session_id",
        "purpose",
        "approved",
        "attempt_status",
        "access",
        "events_file",
        "total_events",
        "end_verified",
        "analysis_start_index",
        "read_receipts"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "data_mode": {
          "enum": [
            "synthetic",
            "research"
          ]
        },
        "dataset_namespace": {
          "type": "string",
          "pattern": "(?:SYN|DS)-[A-Z0-9-]{1,64}"
        },
        "participant_id": {
          "type": "string",
          "pattern": "P-[A-Z0-9-]{1,48}"
        },
        "task_id": {
          "type": "string",
          "pattern": "T-[A-Z0-9-]{1,48}"
        },
        "adapter": {
          "enum": [
            "synthetic-export-v1",
            "bionic-introspection-normalized-unverified"
          ]
        },
        "model_observation": {
          "$ref": "#/$defs/model"
        },
        "model_context": {
          "$ref": "#/$defs/model_context"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          },
          "minItems": 1,
          "uniqueItems": false
        }
      },
      "required": [
        "schema_version",
        "data_mode",
        "dataset_namespace",
        "participant_id",
        "task_id",
        "adapter",
        "model_observation",
        "sessions"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 1
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "actor": {
          "enum": [
            "user",
            "assistant",
            "tool",
            "system"
          ]
        },
        "kind": {
          "enum": [
            "user_message",
            "assistant_statement",
            "tool_request",
            "tool_success",
            "tool_failure",
            "tool_cancelled",
            "system_event",
            "compaction",
            "private"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "phase": {
          "enum": [
            "task",
            "analysis"
          ]
        },
        "content_complete": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "source_index",
        "source_id",
        "source_sequence",
        "timestamp",
        "actor",
        "kind",
        "visibility",
        "phase",
        "content_complete",
        "text"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "coding": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
        },
        "decision": {
          "enum": [
            "coded",
            "deferred",
            "unclassified"
          ]
        },
        "categories": {
          "type": "array",
          "items": {
            "enum": [
              "goal_specification",
              "task_decomposition",
              "delegation_control",
              "verification_request",
              "error_correction",
              "reuse_resume",
              "data_structure_inquiry"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "criterion_codes": {
          "type": "array",
          "items": {
            "enum": [
              "explicit_goal_or_constraint",
              "explicit_parts_or_order",
              "explicit_delegation_or_boundary",
              "explicit_evidence_or_check_request",
              "explicit_error_or_revision",
              "explicit_prior_result_or_resume",
              "explicit_structure_request"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "ambiguity": {
          "enum": [
            null,
            "ambiguous_intent",
            "insufficient_context"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "related_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "source_ref",
        "decision",
        "categories",
        "criterion_codes",
        "ambiguity",
        "evidence",
        "related_refs"
      ],
      "additionalProperties": false
    },
    "codings": {
      "type": "object",
      "properties": {
        "taxonomy_version": {
          "const": "instruction-patterns-0.1.0"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coding"
          },
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": [
        "taxonomy_version",
        "entries"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "E-[0-9a-f]{64}"
        },
        "participant_id": {
          "type": "string",
          "pattern": "P-[A-Z0-9-]{1,48}"
        },
        "task_id": {
          "type": "string",
          "pattern": "T-[A-Z0-9-]{1,48}"
        },
        "session_id": {
          "type": "string",
          "pattern": "S-[A-Z0-9-]{1,48}"
        },
        "source_index": {
          "type": "integer",
          "minimum": 1
        },
        "source_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "actor": {
          "enum": [
            "user",
            "assistant",
            "tool",
            "system"
          ]
        },
        "observation": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "enum": [
              "goal_specification",
              "task_decomposition",
              "delegation_control",
              "verification_request",
              "error_correction",
              "reuse_resume",
              "data_structure_inquiry"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "decision": {
          "enum": [
            "coded",
            "deferred",
            "unclassified",
            "not_user"
          ]
        },
        "ambiguity": {
          "enum": [
            null,
            "ambiguous_intent",
            "insufficient_context"
          ]
        },
        "criterion_codes": {
          "type": "array",
          "items": {
            "enum": [
              "explicit_goal_or_constraint",
              "explicit_parts_or_order",
              "explicit_delegation_or_boundary",
              "explicit_evidence_or_check_request",
              "explicit_error_or_revision",
              "explicit_prior_result_or_resume",
              "explicit_structure_request"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "source_ref": {
          "type": "string",
          "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
        },
        "ref_kind": {
          "const": "package_row"
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "content_complete": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "related_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "event_id",
        "participant_id",
        "task_id",
        "session_id",
        "source_index",
        "source_sequence",
        "actor",
        "observation",
        "categories",
        "decision",
        "ambiguity",
        "criterion_codes",
        "source_ref",
        "ref_kind",
        "timestamp",
        "content_complete",
        "evidence",
        "related_refs"
      ],
      "additionalProperties": false
    },
    "count": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "goal_specification",
            "task_decomposition",
            "delegation_control",
            "verification_request",
            "error_correction",
            "reuse_resume",
            "data_structure_inquiry"
          ]
        },
        "label": {
          "type": "string"
        },
        "criterion": {
          "enum": [
            "explicit_goal_or_constraint",
            "explicit_parts_or_order",
            "explicit_delegation_or_boundary",
            "explicit_evidence_or_check_request",
            "explicit_error_or_revision",
            "explicit_prior_result_or_resume",
            "explicit_structure_request"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "proportion": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "E-[0-9a-f]{64}"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "category",
        "label",
        "criterion",
        "count",
        "denominator",
        "proportion",
        "event_ids"
      ],
      "additionalProperties": false
    },
    "patterns": {
      "type": "object",
      "properties": {
        "skill_version": {
          "enum": [
            "0.1.0",
            "0.2.0"
          ]
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "taxonomy_version": {
          "const": "instruction-patterns-0.1.0"
        },
        "review_status": {
          "const": "draft"
        },
        "denominator_definition": {
          "const": "included_unique_public_user_events"
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count"
          },
          "minItems": 7,
          "uniqueItems": false
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "E-[0-9a-f]{64}"
              },
              "source_ref": {
                "type": "string",
                "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
              },
              "reason": {
                "enum": [
                  "ambiguous_intent",
                  "insufficient_context"
                ]
              }
            },
            "required": [
              "event_id",
              "source_ref",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "unclassified_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "E-[0-9a-f]{64}"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": [
        "skill_version",
        "schema_version",
        "taxonomy_version",
        "review_status",
        "denominator_definition",
        "denominator",
        "counts",
        "uncertainties",
        "unclassified_event_ids",
        "actions"
      ],
      "additionalProperties": false
    },
    "coverage_session": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "S-[A-Z0-9-]{1,48}"
        },
        "attempt_status": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "interrupted",
            "resumed",
            "unknown"
          ]
        },
        "approval": {
          "type": "boolean"
        },
        "purpose": {
          "enum": [
            "task",
            "analysis"
          ]
        },
        "status": {
          "enum": [
            "complete_public_scope",
            "partial",
            "excluded_analysis_session",
            "missing_approval",
            "missing_access",
            "unreadable",
            "missing_record"
          ]
        },
        "total_events": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "read_ranges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "uniqueItems": false
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "read_rows": {
          "type": "integer",
          "minimum": 0
        },
        "included_events": {
          "type": "integer",
          "minimum": 0
        },
        "missing_ranges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "uniqueItems": false
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
              },
              "reason": {
                "enum": [
                  "private_content",
                  "compaction_summary",
                  "after_extraction_start"
                ]
              }
            },
            "required": [
              "ref",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "duplicates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
              },
              "canonical_ref": {
                "type": "string",
                "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
              }
            },
            "required": [
              "ref",
              "canonical_ref"
