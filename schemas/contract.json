        "requested_sessions",
        "requested_task_sessions",
        "read_sessions",
        "included_events",
        "included_user_events",
        "sessions",
        "source_hashes",
        "manifest_sha256",
        "codings_sha256",
        "model_observation",
        "implementation_sha256",
