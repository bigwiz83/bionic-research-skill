            "minItems": 2,
            "uniqueItems": false
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "read_rows": {
          "type": "integer",
          "minimum": 0
        },
        "included_events": {
          "type": "integer",
          "minimum": 0
        },
        "missing_ranges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "uniqueItems": false
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
