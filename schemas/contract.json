            "required": [
              "ref",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "duplicates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
              },
              "canonical_ref": {
                "type": "string",
                "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
              }
            },
            "required": [
              "ref",
              "canonical_ref"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "truncated_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unknown_timestamps": {
          "type": "integer",
          "minimum": 0
        },
        "end_verified": {
          "type": "boolean"
        },
        "receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "[0-9a-f]{64}"
        },
        "error_code": {
          "enum": [
            null,
            "json_unreadable_or_invalid"
          ]
        }
      },
      "required": [
        "session_id",
        "attempt_status",
        "approval",
        "purpose",
        "status",
        "total_events",
        "read_ranges",
        "read_rows",
        "included_events",
        "missing_ranges",
        "excluded",
        "duplicates",
        "truncated_refs",
        "unknown_timestamps",
        "end_verified",
        "receipt_sha256",
        "error_code"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "skill_version": {
          "const": "0.1.0"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "taxonomy_version": {
          "const": "instruction-patterns-0.1.0"
        },
        "data_mode": {
          "enum": [
            "synthetic",
            "research"
          ]
        },
        "dataset_namespace": {
          "type": "string",
          "pattern": "(?:SYN|DS)-[A-Z0-9-]{1,64}"
        },
        "adapter": {
          "enum": [
            "synthetic-export-v1",
            "bionic-introspection-normalized-unverified"
          ]
        },
        "complete_extraction": {
          "type": "boolean"
        },
        "requested_sessions": {
          "type": "integer",
          "minimum": 1
        },
        "requested_task_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "read_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "included_events": {
          "type": "integer",
          "minimum": 0
        },
        "included_user_events": {
