          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "category",
        "label",
        "criterion",
        "count",
        "denominator",
        "proportion",
        "event_ids"
      ],
      "additionalProperties": false
    },
    "patterns": {
      "type": "object",
      "properties": {
        "skill_version": {
          "const": "0.1.0"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "taxonomy_version": {
          "const": "instruction-patterns-0.1.0"
        },
        "review_status": {
          "const": "draft"
        },
        "denominator_definition": {
          "const": "included_unique_public_user_events"
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count"
          },
          "minItems": 7,
          "uniqueItems": false
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "E-[0-9a-f]{64}"
              },
              "source_ref": {
                "type": "string",
                "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
              },
              "reason": {
                "enum": [
                  "ambiguous_intent",
                  "insufficient_context"
                ]
              }
            },
            "required": [
              "event_id",
              "source_ref",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "unclassified_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "E-[0-9a-f]{64}"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": [
        "skill_version",
        "schema_version",
        "taxonomy_version",
        "review_status",
        "denominator_definition",
        "denominator",
        "counts",
        "uncertainties",
        "unclassified_event_ids",
        "actions"
      ],
      "additionalProperties": false
    },
    "coverage_session": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "S-[A-Z0-9-]{1,48}"
