        "contract_sha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "skill_sha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "taxonomy_sha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
