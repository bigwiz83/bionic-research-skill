{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bionic-research-skill:1.0.0",
  "title": "Bionic normalized synthetic and research session intake and output contract",
  "$defs": {
    "span": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "ref",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "[A-Za-z0-9_./:-]{1,128}"
        },
        "model_id_confirmed": {
          "type": "boolean"
        },
        "settings_confirmed": {
          "type": "boolean"
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "top_p": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "context_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "model_id",
        "model_id_confirmed",
        "settings_confirmed",
        "temperature",
        "top_p",
        "context_length"
      ],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "S-[A-Z0-9-]{1,48}"
        },
        "purpose": {
          "enum": [
            "task",
            "analysis"
          ]
        },
        "approved": {
          "type": "boolean"
        },
        "attempt_status": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "interrupted",
            "resumed",
            "unknown"
          ]
        },
        "access": {
          "enum": [
            "available",
            "missing_access",
            "unreadable",
            "missing_record"
          ]
        },
        "events_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "total_events": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "end_verified": {
          "type": "boolean"
        },
        "analysis_start_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "read_receipts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": [
        "session_id",
        "purpose",
        "approved",
        "attempt_status",
        "access",
        "events_file",
        "total_events",
        "end_verified",
        "analysis_start_index",
        "read_receipts"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "data_mode": {
          "enum": [
            "synthetic",
            "research"
          ]
        },
        "dataset_namespace": {
          "type": "string",
          "pattern": "(?:SYN|DS)-[A-Z0-9-]{1,64}"
        },
        "participant_id": {
          "type": "string",
          "pattern": "P-[A-Z0-9-]{1,48}"
        },
        "task_id": {
          "type": "string",
          "pattern": "T-[A-Z0-9-]{1,48}"
        },
        "adapter": {
          "enum": [
            "synthetic-export-v1",
            "bionic-introspection-normalized-unverified"
          ]
        },
        "model_observation": {
          "$ref": "#/$defs/model"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          },
          "minItems": 1,
          "uniqueItems": false
        }
      },
      "required": [
        "schema_version",
        "data_mode",
        "dataset_namespace",
        "participant_id",
        "task_id",
        "adapter",
        "model_observation",
        "sessions"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 1
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "actor": {
          "enum": [
            "user",
            "assistant",
            "tool",
            "system"
          ]
        },
        "kind": {
          "enum": [
            "user_message",
            "assistant_statement",
            "tool_request",
            "tool_success",
            "tool_failure",
            "tool_cancelled",
            "system_event",
            "compaction",
            "private"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "phase": {
          "enum": [
            "task",
            "analysis"
          ]
        },
        "content_complete": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "source_index",
        "source_id",
        "source_sequence",
        "timestamp",
        "actor",
        "kind",
        "visibility",
        "phase",
        "content_complete",
        "text"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "coding": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
        },
        "decision": {
          "enum": [
            "coded",
            "deferred",
            "unclassified"
          ]
        },
        "categories": {
          "type": "array",
          "items": {
            "enum": [
              "goal_specification",
              "task_decomposition",
              "delegation_control",
              "verification_request",
              "error_correction",
              "reuse_resume",
              "data_structure_inquiry"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "criterion_codes": {
          "type": "array",
          "items": {
            "enum": [
              "explicit_goal_or_constraint",
              "explicit_parts_or_order",
              "explicit_delegation_or_boundary",
              "explicit_evidence_or_check_request",
              "explicit_error_or_revision",
              "explicit_prior_result_or_resume",
              "explicit_structure_request"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "ambiguity": {
          "enum": [
            null,
            "ambiguous_intent",
            "insufficient_context"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "related_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "source_ref",
        "decision",
        "categories",
        "criterion_codes",
        "ambiguity",
        "evidence",
        "related_refs"
      ],
      "additionalProperties": false
    },
    "codings": {
      "type": "object",
      "properties": {
        "taxonomy_version": {
          "const": "instruction-patterns-0.1.0"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coding"
          },
          "minItems": 0,
          "uniqueItems": false
