      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "E-[0-9a-f]{64}"
        },
        "participant_id": {
          "type": "string",
          "pattern": "P-[A-Z0-9-]{1,48}"
        },
        "task_id": {
          "type": "string",
          "pattern": "T-[A-Z0-9-]{1,48}"
        },
        "session_id": {
          "type": "string",
          "pattern": "S-[A-Z0-9-]{1,48}"
        },
        "source_index": {
          "type": "integer",
          "minimum": 1
        },
        "source_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "actor": {
          "enum": [
            "user",
            "assistant",
            "tool",
            "system"
          ]
        },
        "observation": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "enum": [
              "goal_specification",
              "task_decomposition",
              "delegation_control",
              "verification_request",
              "error_correction",
              "reuse_resume",
              "data_structure_inquiry"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "decision": {
          "enum": [
            "coded",
            "deferred",
            "unclassified",
            "not_user"
          ]
        },
        "ambiguity": {
          "enum": [
            null,
            "ambiguous_intent",
            "insufficient_context"
          ]
        },
        "criterion_codes": {
          "type": "array",
          "items": {
            "enum": [
              "explicit_goal_or_constraint",
              "explicit_parts_or_order",
              "explicit_delegation_or_boundary",
              "explicit_evidence_or_check_request",
              "explicit_error_or_revision",
              "explicit_prior_result_or_resume",
              "explicit_structure_request"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "source_ref": {
          "type": "string",
          "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
        },
        "ref_kind": {
          "const": "package_row"
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "content_complete": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "related_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "S-[A-Z0-9-]{1,48}/row-[0-9]{6,}"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "event_id",
        "participant_id",
        "task_id",
        "session_id",
        "source_index",
        "source_sequence",
        "actor",
        "observation",
        "categories",
        "decision",
        "ambiguity",
        "criterion_codes",
        "source_ref",
        "ref_kind",
        "timestamp",
        "content_complete",
        "evidence",
        "related_refs"
      ],
      "additionalProperties": false
    },
    "count": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "goal_specification",
            "task_decomposition",
            "delegation_control",
            "verification_request",
            "error_correction",
            "reuse_resume",
            "data_structure_inquiry"
          ]
        },
        "label": {
          "type": "string"
        },
        "criterion": {
          "enum": [
            "explicit_goal_or_constraint",
            "explicit_parts_or_order",
            "explicit_delegation_or_boundary",
            "explicit_evidence_or_check_request",
            "explicit_error_or_revision",
            "explicit_prior_result_or_resume",
            "explicit_structure_request"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "proportion": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
